<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>EVE-O Preview</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace />
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="EveOPreview.app.manifest" />
    <EmbeddedResource Include="EveOPreview.app.manifest" LogicalName="EveOPreview.app.manifest" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Core" />
    <Reference Include="WindowsBase" />
    <Reference Include="LightInject"><HintPath>..\lib\lightinject.dll</HintPath></Reference>
    <Reference Include="MediatR"><HintPath>..\lib\mediatr.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>..\lib\newtonsoft.json.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Re-embed the libraries into a single exe, like the original build -->
    <PackageReference Include="Fody" Version="6.8.2" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
